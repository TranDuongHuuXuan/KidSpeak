# ==============================================================================
# KidSpeak Backend Configuration Template
# Sao chép file này thành .env và điền các giá trị thực tế
# ==============================================================================

# Cấu hình ứng dụng
APP_NAME=KidSpeak-Backend
APP_ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=8000

# Bảo mật & JWT
SECRET_KEY=replace-with-a-very-strong-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=kidspeak_db
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/kidspeak_db

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Đường dẫn AI Service (nếu chạy AI tách biệt)
AI_SERVICE_URL=http://localhost:8001
