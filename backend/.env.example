# ==============================================================================
# KidSpeak Backend Configuration Template
# Sao chép file này thành .env và điền các giá trị thực tế
# ==============================================================================

# Cấu hình ứng dụng
APP_NAME=KidSpeak-Backend
APP_ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=8000

# Bảo mật & JWT
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=kidspeak_db
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/kidspeak_db

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Đường dẫn AI Service (nếu chạy AI tách biệt)
AI_SERVICE_URL=http://localhost:8001

# Media Storage (MinIO)
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET_NAME=kidspeak-media
MINIO_SECURE=False
MINIO_PUBLIC_ENDPOINT=localhost:9000
MEDIA_URL_EXPIRY_SECONDS=1800
MEDIA_IMAGE_MAX_BYTES=5242880
MEDIA_AUDIO_MAX_BYTES=26214400
