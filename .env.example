# ==============================================================================
# KidSpeak - Root Environment Variables
# Dùng chung cho Docker Compose và các services
# ==============================================================================

# Backend App
APP_NAME=KidSpeak-Backend
APP_ENV=development
DEBUG=True
BACKEND_PORT=8000
SECRET_KEY=replace-with-a-very-strong-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database (PostgreSQL)
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=1234
DB_NAME=kidspeak_db

# AI Service
AI_SERVICE_PORT=8001
AI_DEVICE=cpu
SAMPLE_RATE=16000

# Media Service (MinIO)
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET_NAME=kidspeak-media

# Frontend
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000/api
VITE_MEDIA_BASE_URL=http://localhost:9000/kidspeak-media
